PORT=3000
DATABASE_URL=postgresql://usuario:password@host:5432/base
JWT_SECRET=cambia_esta_clave
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
PUBLIC_APP_URL=
PGSSL=true
# Ruta al certificado raiz del proveedor de PostgreSQL para verificar el servidor (recomendado en produccion)
PGSSL_CA=
# Si la API corre detras de un proxy/balanceador (Render, Nginx, etc.), numero de proxies: 1
TRUST_PROXY=

# Correo obligatorio para facturas.
# SMTP_SERVICE puede ser gmail, outlook, hotmail, yahoo, zoho o custom.
# Si usas un proveedor no reconocido, llena SMTP_HOST.
# Gmail/Outlook/Yahoo suelen requerir contrasena de aplicacion, no la clave normal.
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion
SMTP_FROM=Casales San Pedro <tu_correo@gmail.com>

# CAPTCHA opcional para formularios publicos (Cloudflare Turnstile, gratuito). Deja vacio para desactivarlo.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
